# 至少配置一个 OpenAI-compatible 模型和一个搜索 Provider。
DEFAULT_API_KEY=
DEFAULT_BASE_URL=https://api.deepseek.com/v1
DEFAULT_MODEL=deepseek-chat

# 七角色均可逐字段覆盖；空值表示继承 DEFAULT_*。
LLM_ANALYST_A_API_KEY=
LLM_ANALYST_A_BASE_URL=
LLM_ANALYST_A_MODEL=
LLM_ANALYST_B_API_KEY=
LLM_ANALYST_B_BASE_URL=
LLM_ANALYST_B_MODEL=
LLM_ANALYST_C_API_KEY=
LLM_ANALYST_C_BASE_URL=
LLM_ANALYST_C_MODEL=
LLM_MODERATOR_API_KEY=
LLM_MODERATOR_BASE_URL=
LLM_MODERATOR_MODEL=
LLM_VERIFIER_API_KEY=
LLM_VERIFIER_BASE_URL=
LLM_VERIFIER_MODEL=
LLM_REPORTER_API_KEY=
LLM_REPORTER_BASE_URL=
LLM_REPORTER_MODEL=
LLM_UTILITY_API_KEY=
LLM_UTILITY_BASE_URL=
LLM_UTILITY_MODEL=

# 同一模型服务地址与 API Key 的进程内并行请求上限；默认 2，范围 1-16。
# 这是本地削峰，不代表服务商的 TPM、RPM 或账户额度。
# 所有任务共享该上限；需确认上游容量后逐步调整，并观察排队、429 与重试。
# 等正在运行的任务结束后重启服务使修改生效。
YUQING_LLM_MAX_INFLIGHT=2

# 搜索顺序由产品固定：中文 LangSearch → Exa → 千帆 → 博查；英文 Exa → Tavily → Serper。
# 未配置 Key 的 Provider 自动跳过。
LANGSEARCH_API_KEY=
QIANFAN_API_KEY=
BOCHA_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

# 原文取得：先用搜索 Provider 已返回的全文，再内置直抓，最后仅对关键失败页回退 Firecrawl Cloud。
FETCH_PROVIDER_ORDER=builtin,firecrawl
FIRECRAWL_API_KEY=

YUQING_DATA_DIR=./data
YUQING_DEMO_MODE=false

# Clash/TUN Fake-IP 兼容，默认关闭。仅允许域名解析到 198.18.0.0/15；直接访问该网段仍会拒绝。
YUQING_FETCH_ALLOW_PROXY_FAKE_IP=false

# V2 登录态评论插件默认关闭；仅本机非 Docker 环境可启用。
YUQING_COMMENT_PLUGIN_ENABLED=false
# 可选：评论插件专用 Chrome/Edge 可执行文件；留空时自动发现。
YUQING_COMMENT_BROWSER=

# 演示站治理：单 IP（哈希后）每日创建任务数与报告保留时长。
YUQING_DEMO_DAILY_LIMIT=3
YUQING_DEMO_CONCURRENCY_LIMIT=1
YUQING_DEMO_REPORT_TTL_HOURS=72
YUQING_DEMO_COOKIE_SECURE=false

# 可选：定时采集 DailyHotApi 兼容源。多源用逗号分隔，平台顺序一一对应。
YUQING_HOTLIST_URLS=
YUQING_HOTLIST_PLATFORMS=weibo
YUQING_HOTLIST_INTERVAL_SECONDS=3600

# 可选：PDF 浏览器路径；Windows 默认会自动发现 Edge，容器内默认 Chromium。
YUQING_PDF_BROWSER=

# 可选：覆盖三档调查深度的预算上限（JSON）。留空即用代码默认表（见 02 §8.4）。
# 只写要改的字段；键必须是 quick/standard/deep，字段名见 GET /api/config 的 budget.fields。
# 例：{"deep":{"max_claims":120,"max_verify_calls":300}}
BUDGET_OVERRIDES=
