# 至少配置一个 OpenAI-compatible 模型和一个搜索 Provider。
DEFAULT_API_KEY=
DEFAULT_BASE_URL=https://api.deepseek.com/v1
DEFAULT_MODEL=deepseek-chat

# 七角色均可逐字段覆盖；空值表示继承 DEFAULT_*。
LLM_ANALYST_A_API_KEY=
LLM_ANALYST_A_BASE_URL=
LLM_ANALYST_A_MODEL=
LLM_ANALYST_B_API_KEY=
LLM_ANALYST_B_BASE_URL=
LLM_ANALYST_B_MODEL=
LLM_ANALYST_C_API_KEY=
LLM_ANALYST_C_BASE_URL=
LLM_ANALYST_C_MODEL=
LLM_MODERATOR_API_KEY=
LLM_MODERATOR_BASE_URL=
LLM_MODERATOR_MODEL=
LLM_VERIFIER_API_KEY=
LLM_VERIFIER_BASE_URL=
LLM_VERIFIER_MODEL=
LLM_REPORTER_API_KEY=
LLM_REPORTER_BASE_URL=
LLM_REPORTER_MODEL=
LLM_UTILITY_API_KEY=
LLM_UTILITY_BASE_URL=
LLM_UTILITY_MODEL=

# 从左到右尝试；未配置 Key 的 Provider 自动跳过。
SEARCH_PROVIDER_ORDER=langsearch,zhipu,qianfan,tavily,serper
LANGSEARCH_API_KEY=
ZHIPU_API_KEY=
QIANFAN_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

YUQING_DATA_DIR=./data
YUQING_DEMO_MODE=false

# V2 登录态评论插件默认关闭；仅本机非 Docker 环境可启用。
YUQING_COMMENT_PLUGIN_ENABLED=false
# 可选：评论插件专用 Chrome/Edge 可执行文件；留空时自动发现。
YUQING_COMMENT_BROWSER=

# 演示站治理：单 IP（哈希后）每日创建任务数与报告保留时长。
YUQING_DEMO_DAILY_LIMIT=3
YUQING_DEMO_CONCURRENCY_LIMIT=1
YUQING_DEMO_REPORT_TTL_HOURS=72
YUQING_DEMO_COOKIE_SECURE=false

# 可选：定时采集 DailyHotApi 兼容源。多源用逗号分隔，平台顺序一一对应。
YUQING_HOTLIST_URLS=
YUQING_HOTLIST_PLATFORMS=weibo
YUQING_HOTLIST_INTERVAL_SECONDS=3600

# 可选：PDF 浏览器路径；Windows 默认会自动发现 Edge，容器内默认 Chromium。
YUQING_PDF_BROWSER=
