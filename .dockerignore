# Keep the build context limited to the files copied by the Dockerfile.
**
!frontend/
frontend/*
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/public/
!frontend/src/
!backend/
backend/*
!backend/pyproject.toml
!backend/yuqing/

**/.env
**/.env.*
**/.git
**/__pycache__/
**/node_modules/
**/*.db
**/*.db-*
**/*.docx
**/*.log
