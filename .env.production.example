# 复制为 .env.production 后填写。不要提交真实配置。
# YUQING_DOMAIN 只写域名，例如 opinion.example.com，不要加 https:// 或路径。
YUQING_DOMAIN=YOUR_DOMAIN

# 登录、邮箱验证码与管理员。管理员邮箱通过验证码注册后自动获得管理员权限。
YUQING_AUTH_REQUIRED=true
YUQING_DEMO_MODE=false
YUQING_AUTH_SESSION_SECRET=
YUQING_ADMIN_EMAILS=
YUQING_PUBLIC_ORIGIN=https://YOUR_DOMAIN
YUQING_SMTP_HOST=
YUQING_SMTP_PORT=587
YUQING_SMTP_SECURITY=starttls
YUQING_SMTP_USERNAME=
YUQING_SMTP_PASSWORD=
YUQING_SMTP_FROM=

# 初始额度：按北京时间每账号每日 3 个任务，同时运行 1 个，最多标准模式。
YUQING_ACCOUNT_DAILY_TASK_LIMIT=3
YUQING_ACCOUNT_CONCURRENCY_LIMIT=1
YUQING_ACCOUNT_MAX_DEPTH=standard

# 模型和搜索密钥也可在管理员登录后从配置页填写；环境变量留空即可。
DEFAULT_API_KEY=
DEFAULT_BASE_URL=https://api.siliconflow.cn/v1
DEFAULT_MODEL=zai-org/GLM-5.3-Flash
LANGSEARCH_API_KEY=
QIANFAN_API_KEY=
BOCHA_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
FIRECRAWL_API_KEY=
